{
  "name": "serveproof",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @serveproof/db generate",
    "db:migrate": "pnpm --filter @serveproof/db migrate:dev",
    "dev:web": "pnpm --filter @serveproof/web dev",
    "dev:api": "pnpm --filter @serveproof/api start:dev",
    "dev:worker": "pnpm --filter @serveproof/worker start:dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
