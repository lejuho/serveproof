{
  "name": "serveproof",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @serveproof/db generate",
    "db:migrate": "pnpm --filter @serveproof/db migrate:dev",
    "dev:web": "pnpm --filter @serveproof/web dev",
    "dev:api": "pnpm --filter @serveproof/api start:dev",
    "dev:worker": "pnpm --filter @serveproof/worker start:dev",
    "demo:setup": "bash scripts/demo-setup.sh",
    "demo:doctor": "pnpm --filter @serveproof/solana build && pnpm --filter @serveproof/db build && pnpm --filter @serveproof/db demo:doctor",
    "demo:prepare": "pnpm --filter @serveproof/solana build && pnpm --filter @serveproof/db build && pnpm --filter @serveproof/db demo:prepare",
    "demo:start": "bash scripts/demo-start.sh",
    "demo:stop": "bash scripts/demo-stop.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
