# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local # local | staging | production

# ── Database / Queue ───────────────────────────────────────
DATABASE_URL=postgresql://serveproof:serveproof@localhost:5433/serveproof
REDIS_URL=redis://localhost:6379

# ── Solana ─────────────────────────────────────────────────
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet # localnet | devnet | mainnet-beta
SERVEPROOF_PROGRAM_ID=
USDC_MINT=

# ── Square (Sandbox) ───────────────────────────────────────
SQUARE_APP_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_APP_SECRET=
SQUARE_REDIRECT_URI=http://localhost:3001/providers/square/callback
SQUARE_ENVIRONMENT=sandbox
PROVIDER_ENCRYPTION_KEY=

# ── Object Storage (S3-compatible) ─────────────────────────
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Auth / Signing ─────────────────────────────────────────
AUTH_SECRET=
REPORT_SIGNING_KEY=

# ── Observability ──────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug
