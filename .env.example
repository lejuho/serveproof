# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local # local | staging | production

# ── Database / Queue ───────────────────────────────────────
DATABASE_URL=postgresql://serveproof:serveproof@localhost:5433/serveproof
REDIS_URL=redis://localhost:6379

# ── Solana ─────────────────────────────────────────────────
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet # localnet | devnet | mainnet-beta
SERVEPROOF_PROGRAM_ID=
USDC_MINT=

# ── Square (Sandbox) ───────────────────────────────────────
SQUARE_APP_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_APP_SECRET=
SQUARE_REDIRECT_URI=http://localhost:3001/providers/square/callback
SQUARE_ENVIRONMENT=sandbox
PROVIDER_ENCRYPTION_KEY=

# ── Object Storage (S3-compatible) ─────────────────────────
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Auth / Signing ─────────────────────────────────────────
AUTH_SECRET=
REPORT_SIGNING_KEY=

# ── OTP Email (unset = devCode/allowlist only) ─────────────
# Preferred on Railway (SMTP ports are blocked below Pro): Brevo HTTPS API.
# Verify EMAIL_FROM as a sender at brevo.com, then set the API key.
BREVO_API_KEY=
# Fallback: any SMTP provider (works locally / Railway Pro)
# Gmail: smtp.gmail.com:587 + app password / Resend: smtp.resend.com:465, user "resend", pass = API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Email domains that still get devCode in the API response (demo/E2E accounts)
OTP_DEVCODE_DOMAINS=demo.serveproof.local,staging.serveproof.local

# ── Observability ──────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug
